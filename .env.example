# Copy to .env. .env is gitignored and must never be committed.

# Required by the server; never use the table owner here.
# Development credentials only; replace them when self-hosting. gitleaks:allow
DATABASE_URL=postgres://fukulow_app:fukulow_app@127.0.0.1:15432/fukulow_dev
# Required by migration commands and integration tests, never read by the server.
# Development credentials only. gitleaks:allow
MIGRATOR_DATABASE_URL=postgres://fukulow_migrator:fukulow_migrator@127.0.0.1:15432/fukulow_dev

# Address the server binds to. Loopback by default: publishing on every
# interface is a deployment decision, not a development default.
FUKULOW_BIND_ADDR=127.0.0.1:8080

# tracing-subscriber filter.
RUST_LOG=info

# For build environments that cannot write to $HOME (offline sandboxes).
# CARGO_HOME=./.cargo-home
# CARGO_NET_OFFLINE=true
