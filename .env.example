# Copy to .env. .env is gitignored and must never be committed.

# Not read yet -- it arrives with the schema, together with the pool that makes
# it fail loudly when it is wrong. A variable documented before anything reads it
# cannot be told apart from one that is silently ignored, so it stays commented.
#
# The port is 15432, not 5432, so a system-wide PostgreSQL is not shadowed.
# DATABASE_URL=postgres://fukulow:fukulow@127.0.0.1:15432/fukulow_dev

# Address the server binds to. Loopback by default: publishing on every
# interface is a deployment decision, not a development default.
FUKULOW_BIND_ADDR=127.0.0.1:8080

# tracing-subscriber filter.
RUST_LOG=info

# For build environments that cannot write to $HOME (offline sandboxes).
# CARGO_HOME=./.cargo-home
# CARGO_NET_OFFLINE=true
