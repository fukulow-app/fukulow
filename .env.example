# Copy to .env. .env is gitignored and must never be committed.

# --- Self-hosting with compose.yaml -----------------------------------------
# All four are required and have no default. Compose expands `$` in .env values,
# so single-quote any password containing `$`.
# FUKULOW_DB_ADMIN_PASSWORD=
# FUKULOW_DB_MIGRATOR_PASSWORD=
# FUKULOW_DB_APP_PASSWORD=
# FUKULOW_PUBLIC_ORIGIN is also required; it is set once, in the development
# section below. Change that line to the browser origin, such as
# https://chat.example.com, rather than adding a second one.
# Loopback host port for the server (default 8080).
# FUKULOW_HTTP_PORT=8080

# --- Development and tests (compose.dev.yaml) ---------------------------------

# Required by the server; never use the table owner here.
# Development credentials only; replace them when self-hosting. gitleaks:allow
DATABASE_URL=postgres://fukulow_app:fukulow_app@127.0.0.1:15432/fukulow_dev
# Required by migration commands and integration tests, never read by the server.
# Development credentials only. gitleaks:allow
MIGRATOR_DATABASE_URL=postgres://fukulow_migrator:fukulow_migrator@127.0.0.1:15432/fukulow_dev
# Tests only: inspection as the table owner, bypassing FORCE. The server refuses to
# start when this is set, so keep it out of any environment the server reads.
# Development credentials only. gitleaks:allow
# INSPECTOR_DATABASE_URL=postgres://fukulow:fukulow@127.0.0.1:15432/fukulow_dev

# Address the server binds to. Loopback by default: publishing on every
# interface is a deployment decision, not a development default.
FUKULOW_BIND_ADDR=127.0.0.1:8080

# Required browser origin: HTTPS except for loopback HTTP in development.
# No path, trailing slash, query, fragment or credentials. Written as a browser
# sends it: lower case, and no port when it is the scheme's default.
FUKULOW_PUBLIC_ORIGIN=http://localhost:8080

# tracing-subscriber filter.
RUST_LOG=info

# For build environments that cannot write to $HOME (offline sandboxes).
# CARGO_HOME=./.cargo-home
# CARGO_NET_OFFLINE=true
